# Test corpus trees are verified byte for byte against MANIFEST.json
# (internal/testcorpus): never convert their line endings.
snapshot/testdata/rust/** -text
snapshot/testdata/rust-derived/** -text
testdata/upstream/** -text
# The capability table is compared byte for byte with go/format output
# (internal/spvnames TestTableMatchesVendoredHeaders): keep LF on every OS.
internal/spvnames/table.go -text
# The generated enum set is compared the same way
# (spirv/internal/spvenums TestEnumsMatchVendoredGrammar): keep LF on every OS.
spirv/internal/spvenums/enums.go -text
# Rust naga outputs compared byte for byte (glsl TestOverrideOutputMatchesRust).
glsl/testdata/overrides/** -text
# GLSL goldens compared byte for byte (glsl TestDepthTextureDeclarations and
# TestRestrictBoundsChecks).
glsl/testdata/bounds/** -text
glsl/testdata/depth/** -text
# GPU readback corpus: gogpu/wgpu reads these files from the naga module, and
# TestReadbackReadmeExample cuts the README example at "```json\n".
testdata/readback/** -text

# Shell scripts run under bash on every CI runner, Windows included: keep LF.
*.sh text eol=lf
