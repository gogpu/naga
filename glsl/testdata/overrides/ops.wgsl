override n: u32 = 7u;
override s: i32 = -7;
override f: f32 = 2.5;
override b: bool = true;
@id(13) override wg: u32 = 4u;
var<private> pv: bool = b || false;
var<private> pu: u32 = n % 4u;
@group(0) @binding(0) var<storage, read_write> ou: array<u32>;
@group(0) @binding(1) var<storage, read_write> oi: array<i32>;
@group(0) @binding(2) var<storage, read_write> ofl: array<f32>;
@compute @workgroup_size(wg) fn main() {
  ou[0] = n % 4u;
  ou[1] = n << 1u;
  ou[2] = n >> 1u;
  ou[3] = n & 3u;
  ou[4] = n | 8u;
  ou[5] = n ^ 2u;
  ou[6] = n / 2u;
  ou[7] = n - 8u;
  ou[8] = select(0u, 1u, n == 7u);
  ou[9] = select(0u, 1u, n != 7u);
  ou[10] = select(0u, 1u, n < 3u);
  ou[11] = select(0u, 1u, n <= 7u);
  ou[12] = select(0u, 1u, n > 3u);
  ou[13] = select(0u, 1u, n >= 8u);
  ou[14] = select(0u, 1u, b && false);
  ou[15] = select(0u, 1u, b || false);
  ou[16] = select(0u, 1u, !b);
  ou[17] = max(n, 9u);
  ou[18] = select(1u, 2u, b);
  ou[19] = u32(f);
  ou[20] = ~n;
  ou[21] = select(0u, 1u, pv);
  ou[22] = pu;
  oi[0] = s % 4;
  oi[1] = s / 2;
  oi[2] = s >> 1u;
  oi[3] = -s;
  oi[4] = ~s;
  oi[5] = abs(s);
  ofl[0] = f % 1.0;
  ofl[1] = -f;
  ofl[2] = f * 2.0;
  ofl[3] = f32(n);
  ofl[4] = floor(f);
}
