// language: metal1.0
#include <metal_stdlib>
#include <simd/simd.h>

using metal::uint;
struct DefaultConstructible {
    template<typename T>
    operator T() && {
        return T {};
    }
};

struct Outputs {
    metal::float4 color;
};

struct main_Output {
    metal::float4 color [[color(0)]];
};
fragment main_Output main_(
) {
    const auto _tmp = Outputs {metal::float4 {}};
    return main_Output { _tmp.color };
    const auto _tmp = Outputs {metal::float4 {}};
    return main_Output { _tmp.color };
}
