// language: metal1.0
#include <metal_stdlib>
#include <simd/simd.h>

using metal::uint;
struct DefaultConstructible {
    template<typename T>
    operator T() && {
        return T {};
    }
};


struct main_Output {
    metal::float4 member [[color(0)]];
};
fragment main_Output main_(
  metal::texture1d<float, metal::access::sample> sampled_texture_1d [[user(fake0)]]
, metal::texture2d<float, metal::access::sample> sampled_texture_2d [[user(fake0)]]
, metal::texture3d<float, metal::access::sample> sampled_texture_3d [[user(fake0)]]
, metal::sampler texture_sampler [[user(fake0)]]
) {
    metal::float4 sample_1d = sampled_texture_1d.sample(texture_sampler, 0.5, metal::level(0.0), -1);
    metal::float4 sample_2d = sampled_texture_2d.sample(texture_sampler, metal::float2(0.5), metal::level(0.0), metal::int2(-1, 2));
    metal::float4 sample_3d = sampled_texture_3d.sample(texture_sampler, metal::float3(0.5), metal::level(0.0), metal::int3(-1, 2, -3));
    return main_Output { (sample_1d + sample_2d) + sample_3d };
}
