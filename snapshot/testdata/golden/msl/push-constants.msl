fragment main_Output main_(
  main_Input varyings_1 [[stage_in]]
, constant ImmediateDataFrag& im_frag [[user(fake0)]]
) {
    const FragmentIn in = { varyings_1.color };
    metal::float4 _e4 = im_frag.tint;
