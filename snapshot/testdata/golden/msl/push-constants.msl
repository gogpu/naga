};
vertex vert_mainOutput vert_main(
  vert_mainInput varyings [[stage_in]]
, uint ii [[instance_id]]
, uint vi [[vertex_id]]
, constant ImmediateDataVert& im_vert [[user(fake0)]]
) {
    const auto pos = varyings.pos;
